# Smoke test: a handful of instructions with known effects.
# DII serves these in order regardless of PC.
00500093   # addi x1, x0, 5
00300113   # addi x2, x0, 3
002081b3   # add  x3, x1, x2      -> x3 = 8
40208233   # sub  x4, x1, x2      -> x4 = 2
0020f2b3   # and  x5, x1, x2      -> x5 = 1
0020e333   # or   x6, x1, x2      -> x6 = 7
0020c3b3   # xor  x7, x1, x2      -> x7 = 6
0020a433   # slt  x8, x1, x2      -> x8 = 0
001124b3   # slt  x9, x2, x1      -> x9 = 1
00209533   # sll  x10, x1, x2     -> x10 = 40
