[options]
mode cover
depth 2

[engines]
smtbmc boolector

[script]
read_verilog -sv -DFORMAL rv32i_cpu.sv
read_verilog -sv rv32i_alu.sv
read_verilog -sv regfile.sv
read_verilog -sv decoder.sv
read_verilog -sv control.sv
read_verilog -sv pc_bind.sv
prep -top pc_formal

[files]
../rtl/rv32i_cpu.sv
../rtl/rv32i_alu.sv
../rtl/regfile.sv
../rtl/decoder.sv
../rtl/control.sv
pc_bind.sv
